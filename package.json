{
  "name": "latchi-social-hub",
  "productName": "LATCHI SOCIAL HUB",
  "version": "0.4.0",
  "description": "Unified desktop hub for Instagram, Facebook, Messenger, WhatsApp, Gmail, Outlook, YouTube and Telegram — LATCHI",
  "main": "src/main/main.js",
  "author": "LATCHI",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "build:win": "electron-builder --win nsis --x64 --publish never",
    "dist:win": "electron-builder --win nsis portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.latchi.socialhub",
    "productName": "LATCHI SOCIAL HUB",
    "copyright": "© 2026 LATCHI",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "asar": true,
    "files": [
      "src/**/*",
      "!src/main/smoke.js",
      "!src/assets/_legacy",
      "assets/**/*",
      "LICENSE"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeCliInspectArguments": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "onlyLoadAppFromAsar": true
    },
    "win": {
      "icon": "build/icon.ico",
      "signExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LATCHI SOCIAL HUB",
      "uninstallDisplayName": "LATCHI SOCIAL HUB",
      "deleteAppDataOnUninstall": false,
      "artifactName": "LATCHI-SOCIAL-HUB-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "LATCHI-SOCIAL-HUB-Portable-${version}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png"
    },
    "mac": {
      "icon": "build/icon.png"
    }
  }
}
