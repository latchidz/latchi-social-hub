# dependencies
node_modules/

# build output (Windows artifacts are built per-release, never committed)
dist/
out/
build/*
!build/icon.ico
!build/icon.png
release/
installer/

# logs & system files
*.log
npm-debug.log*
.DS_Store
Thumbs.db
desktop.ini

